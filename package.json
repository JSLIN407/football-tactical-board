{
  "name": "football-tactical-board",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5199",
    "build": "node scripts/pack-mobile-app.mjs icons && tsc -b && vite build",
    "build:mobile": "npm run build && node scripts/pack-mobile-app.mjs bundle",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "preview": "vite preview --host --port 5199",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  }
}
